# systemd のユーザーサービス。インストール:
#   cp scripts/feedpipe-bot.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now feedpipe-bot
# ログ: journalctl --user -u feedpipe-bot -f
[Unit]
Description=feedpipe Discord bot
After=network-online.target

[Service]
WorkingDirectory=%h/workspace/rss
ExecStart=%h/workspace/rss/.venv/bin/feedpipe bot
Restart=on-failure
RestartSec=30
# ログを journal にすぐ出す
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
