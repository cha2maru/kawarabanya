# systemd のユーザーサービス。インストール: scripts/install.sh --service
#（%h/workspace/rss をこのリポジトリの場所に置き換えて ~/.config/systemd/user/ に置く）
# ログ: journalctl --user -u kawarabanya-bot -f
[Unit]
Description=kawarabanya Discord bot
After=network-online.target

[Service]
WorkingDirectory=%h/workspace/rss
ExecStart=%h/workspace/rss/.venv/bin/kawarabanya bot
Restart=on-failure
RestartSec=30
# ログを journal にすぐ出す
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
