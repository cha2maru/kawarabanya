{
    "display_information": {
        "name": "kawarabanya",
        "description": "RSS の記事・まとめ・予定を投稿する個人用 Bot"
    },
    "features": {
        "bot_user": {
            "display_name": "kawarabanya",
            "always_online": true
        }
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "chat:write.customize",
                "channels:read",
                "channels:manage",
                "channels:join",
                "groups:read",
                "groups:write",
                "reactions:read",
                "reactions:write",
                "app_mentions:read",
                "channels:history",
                "groups:history"
            ]
        }
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_mention",
                "reaction_added",
                "reaction_removed"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_hosted": false,
        "token_rotation_enabled": false
    }
}
