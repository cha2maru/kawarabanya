# kawarabanya の秘密情報（git 管理外）

# Discord Bot のトークン
# https://discord.com/developers/applications → アプリ → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Slack（[chat] targets に "slack" を入れたときだけ）
# https://api.slack.com/apps → アプリ → OAuth & Permissions → Bot User OAuth Token（xoxb-）
SLACK_BOT_TOKEN=
# Basic Information → App-Level Tokens（connections:write、xapp-）。Bot が Socket Mode でつなぐ
SLACK_APP_TOKEN=
